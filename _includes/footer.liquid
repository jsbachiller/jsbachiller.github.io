{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      &copy; Copyright {{ site.time | date: '%Y' }}
      {{ site.first_name }}
      {{ site.middle_name }}
      {{ site.last_name }}. {{ site.data[site.active_lang].strings.footer_text }}
      {% if site.impressum_path %}
        <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
      {% endif %}
      {% if site.last_updated %}
        Last updated: {{ 'now' | date: '%B %d, %Y' }}.
      {% endif %}
      <a href="https://www.simpleanalytics.com?utm_source=example.com&utm_content=badge" referrerpolicy="origin" target="_blank">
        <picture>
          <source
            srcset="https://simpleanalyticsbadges.com/example.com?mode=dark&counter=false&radius=10"
            media="(prefers-color-scheme: dark)"
          />
          <img
            src="https://simpleanalyticsbadges.com/example.com?mode=light&counter=false&radius=10"
            loading="lazy"
            referrerpolicy="no-referrer"
            crossorigin="anonymous"
          />
        </picture>
      </a>
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include scripts/newsletter.liquid %}
    {% endif %}

    <div class="container">
      &copy; Copyright {{ site.time | date: '%Y' }}
      {{ site.first_name }}
      {{ site.middle_name }}
      {{ site.last_name }}. {{ site.data[site.active_lang].strings.footer_text }}
      {% if site.impressum_path %}
        <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
      {% endif %}
      {% if site.last_updated %}
        Last updated: {{ 'now' | date: '%B %d, %Y' }}.
      {% endif %}
      
      <a href="https://www.simpleanalytics.com?utm_source=example.com&utm_content=badge" referrerpolicy="origin" target="_blank">
        <picture>
          <source
            srcset="https://simpleanalyticsbadges.com/example.com?mode=dark&counter=false&radius=10"
            media="(prefers-color-scheme: dark)"
          />
          <img
            src="https://simpleanalyticsbadges.com/example.com?mode=light&counter=false&radius=10"
            loading="lazy"
            referrerpolicy="no-referrer"
            crossorigin="anonymous"
          />
        </picture>
      </a>
    </div>
  </footer>
{% endif %}
